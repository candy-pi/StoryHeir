.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* 底部主按钮固定常驻，列表底部预留按钮高度+安全区，避免末尾内容被遮挡 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx);
}

/* 顶部品牌区：印章 + 书名 + 装饰线 + 简介，居中对称，突出传承质感 */
.hero {
  padding-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.hero-mark { margin-bottom: 24rpx; }
.hero .title-xl { letter-spacing: 8rpx; }
.hero .slogan {
  font-size: 40rpx;
  color: #A0522D;
  margin-top: 20rpx;
  font-weight: 600;
}
.hero .desc {
  font-size: 32rpx;
  color: #5b5145;
  margin-top: 32rpx;
  line-height: 1.8;
}

/* 家风墙：从故事里提炼的价值观，标签随出现频次变大 */
.values-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-top: 32rpx;
}
.values-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.values-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2218;
}
.values-refresh {
  font-size: 26rpx;
  color: #A0522D;
  padding: 8rpx 0 8rpx 16rpx;
}
.values-wall {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 20rpx;
}
.value-tag {
  background-color: #FBF7F0;
  border: 2rpx solid #e8ddcd;
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  color: #5b5145;
}
/* 频次越高字号越大、色调越深：反复念叨的家训更显眼 */
.value-tag.size-lg { font-size: 36rpx; color: #A0522D; border-color: #A0522D; font-weight: 600; }
.value-tag.size-md { font-size: 32rpx; color: #8a5a33; }
.value-tag.size-sm { font-size: 28rpx; }
.value-empty {
  font-size: 28rpx;
  color: #6e6354;
  text-align: center;
  padding: 24rpx 0;
}

/* 家风详情弹层：点标签看原句出处，从底部滑出 */
.value-pop {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
}
.value-pop-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background-color: rgba(43, 34, 24, 0.45);
}
.value-pop-box {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background-color: #FBF7F0;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
.value-pop-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #A0522D;
  margin-bottom: 24rpx;
}
.value-quote {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #3a3228;
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.value-quote-src {
  font-size: 26rpx;
  color: #6e6354;
  margin-top: 12rpx;
}

/* 家族故事列表 */
.stories {
  flex: 1;
  width: 100%;
  margin-top: 48rpx;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2B2218;
}
.story-item {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 20rpx;
}
.story-item-title {
  font-size: 36rpx;
  color: #2B2218;
  font-weight: 600;
}
.story-item-meta {
  font-size: 28rpx;
  /* 次要文字加深至对比度 ≥4.5:1（原 #a89b88 仅约 2:1，老人看不清） */
  color: #6e6354;
  margin-top: 12rpx;
}

/* 列表骨架卡：与真实 story-item 尺寸接近，加载转场不突兀 */
.skel-story {
  height: 140rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

/* 主按钮固定屏幕底部常驻，故事再多也不必下滑到底 */
.entry {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background-color: #FBF7F0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  box-shadow: 0 -4rpx 16rpx rgba(43,34,24,0.06);
  z-index: 10;
}
/* 抹掉 button 默认左右内边距，避免长文字被挤出显示不全 */
.entry .btn-primary {
  box-sizing: border-box;
  padding: 0;
}
.entry .tip {
  text-align: center;
  font-size: 30rpx;
  color: #6e6354;
  margin-top: 28rpx;
}

/* 空态示例入口 */
.demo-link {
  text-align: center;
  font-size: 30rpx;
  color: #A0522D;
  padding: 48rpx 0;
}

/* 编年志入口：常驻故事列表右上；加大点击热区（原纯文字热区过窄，老人易点偏） */
.chron-link {
  font-size: 30rpx;
  color: #A0522D;
  font-weight: 600;
  padding: 12rpx 0 12rpx 24rpx;
}
