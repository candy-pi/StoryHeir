.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* 底部主按钮固定常驻，列表底部预留按钮高度+安全区，避免末尾内容被遮挡 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx);
}

/* 顶部品牌区：印章 + 书名 + 装饰线 + 简介，居中对称，突出传承质感 */
.hero {
  padding-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.hero-mark { margin-bottom: 24rpx; }
.memory-seal {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border: 2rpx solid #ba8f66;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #fffaf1, #ecd9be);
  color: #874427;
  font-family: "Songti SC", "Noto Serif CJK SC", SimSun, serif;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(113, 55, 31, .14);
}
.seal-wave {
  position: relative;
  width: 5rpx;
  height: 15rpx;
  margin-top: 7rpx;
  color: #945c37;
  background: currentColor;
  border-radius: 5rpx;
}
.seal-wave::before,
.seal-wave::after {
  content: '';
  position: absolute;
  top: 4rpx;
  width: 5rpx;
  height: 7rpx;
  background: currentColor;
  border-radius: 5rpx;
}
.seal-wave::before { left: -9rpx; }
.seal-wave::after { right: -9rpx; }

.memory-seal::after {
  content: '';
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  left: 7rpx;
  border: 1rpx solid rgba(151, 98, 54, .42);
  border-radius: 19rpx;
}
.hero .title-xl { letter-spacing: 8rpx; }
.hero .slogan {
  font-size: 40rpx;
  color: #A0522D;
  margin-top: 20rpx;
  font-weight: 600;
}
.hero .desc {
  font-size: 32rpx;
  color: #5b5145;
  margin-top: 32rpx;
  line-height: 1.8;
}

/* 家族故事列表 */
.stories {
  flex: 1;
  width: 100%;
  margin-top: 48rpx;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2B2218;
}
.story-item {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 20rpx;
}
.story-item-title {
  font-size: 36rpx;
  color: #2B2218;
  font-weight: 600;
}
.story-item-meta {
  font-size: 28rpx;
  /* 次要文字加深至对比度 ≥4.5:1（原 #a89b88 仅约 2:1，老人看不清） */
  color: #6e6354;
  margin-top: 12rpx;
}

/* 列表骨架卡：与真实 story-item 尺寸接近，加载转场不突兀 */
.skel-story {
  height: 140rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

/* 主按钮固定屏幕底部常驻，故事再多也不必下滑到底 */
.entry {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background-color: #FBF7F0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  box-shadow: 0 -4rpx 16rpx rgba(43,34,24,0.06);
  z-index: 10;
}
/* 抹掉 button 默认左右内边距，避免长文字被挤出显示不全 */
.entry .btn-primary {
  box-sizing: border-box;
  padding: 0;
}
.entry .tip {
  text-align: center;
  font-size: 30rpx;
  color: #6e6354;
  margin-top: 28rpx;
}

/* 空态示例入口 */
.demo-link {
  text-align: center;
  font-size: 30rpx;
  color: #A0522D;
  padding: 48rpx 0;
}

/* 编年志入口：常驻故事列表右上；加大点击热区（原纯文字热区过窄，老人易点偏） */
.chron-link {
  font-size: 30rpx;
  color: #A0522D;
  font-weight: 600;
  padding: 12rpx 0 12rpx 24rpx;
}

.family-head { width: 100%; gap: 12rpx; }
.family-title {
  flex: 0 0 30%;
  width: 30%;
  box-sizing: border-box;
  white-space: nowrap;
}
.family-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 12rpx;
}
.family-action {
  flex: 1;
  width: 50%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0 8rpx;
  height: 58rpx;
  line-height: 56rpx;
  white-space: nowrap;
  font-size: 24rpx;
  color: #A0522D;
  background: #fff;
  border: 2rpx solid #d8c6ae;
  border-radius: 28rpx;
}
.family-action::after { border: 0; }
.family-item { display: flex; align-items: center; justify-content: space-between; }
.family-item-main { flex: 1; min-width: 0; }
.family-item .story-item-meta { margin-top: 10rpx; }
.family-delete { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; line-height: 60rpx; box-sizing: border-box; margin: 0 0 0 20rpx; padding: 0; border-radius: 50%; font-size: 38rpx; color: #a23220; background: #fbf1ed; }
.family-delete::after { border: 0; }
.family-empty { padding: 52rpx 20rpx; text-align: center; color: #6e6354; font-size: 28rpx; line-height: 1.7; }
.family-modal { position: fixed; inset: 0; z-index: 100; }
.family-modal-mask { position: absolute; inset: 0; background: rgba(43,34,24,.48); }
.family-modal-box {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 50%;
  box-sizing: border-box;
  transform: translateY(-50%);
  background: #FBF7F0;
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
}
.family-modal-title { font-size: 36rpx; font-weight: 700; color: #2B2218; margin-bottom: 28rpx; }
.family-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 82rpx;
  line-height: 82rpx;
  background: #fff;
  border: 2rpx solid #e8ddcd;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  font-size: 30rpx;
}
.family-choice { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; font-size: 32rpx; color: #2B2218; }
.family-modal-cancel { text-align: center; color: #6e6354; padding-top: 26rpx; font-size: 28rpx; }

/* 首页视觉精修 */
.hero {
  position: relative;
  box-sizing: border-box;
  padding: 44rpx 34rpx 40rpx;
  border: 1rpx solid rgba(168, 91, 50, .12);
  border-radius: 36rpx;
  background: linear-gradient(155deg, rgba(255,255,255,.92), rgba(245,234,219,.88));
  box-shadow: 0 14rpx 38rpx rgba(78, 55, 35, .08);
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -80rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(196,154,90,.09);
}
.hero .title-xl { color: #342b23; }
.hero .slogan { color: #934a2a; }
.hero .desc { color: #665a4d; }

.stories { margin-top: 42rpx; }
.section-title { color: #342b23; letter-spacing: 1rpx; }
.story-item {
  border: 1rpx solid rgba(151,115,82,.12);
  box-shadow: 0 10rpx 28rpx rgba(73,52,34,.07);
  transition: transform .16s ease, box-shadow .16s ease;
}
.story-item:active { transform: scale(.985); box-shadow: 0 5rpx 16rpx rgba(73,52,34,.08); }
.story-item-title { color: #342b23; }
.family-action {
  color: #914927;
  border-color: #d5b493;
  background: rgba(255,255,255,.9);
  box-shadow: 0 4rpx 12rpx rgba(92,61,36,.06);
}
.family-delete { border: 1rpx solid rgba(176,58,46,.12); }
.family-empty {
  margin-top: 12rpx;
  border: 2rpx dashed #d8c6b2;
  border-radius: 24rpx;
  background: rgba(255,255,255,.42);
}
.entry {
  background: rgba(246,242,235,.96);
  border-top: 1rpx solid rgba(142,102,68,.1);
  box-shadow: 0 -12rpx 34rpx rgba(63,45,31,.08);
}
.entry .tip { margin-top: 16rpx; color: #76695a; }
.family-modal-mask { background: rgba(37,30,24,.56); }
.family-modal-box {
  max-width: 700rpx;
  margin: 0 auto;
  border: 1rpx solid rgba(151,115,82,.14);
  background: #faf7f1;
  box-shadow: 0 30rpx 80rpx rgba(37,30,24,.22);
}
.family-input {
  color: #332b24;
  border-color: #dfd1c0;
  background: #fff;
  box-shadow: inset 0 2rpx 6rpx rgba(71,48,29,.035);
}
.family-choice {
  border: 1rpx solid rgba(151,115,82,.12);
  box-shadow: 0 6rpx 18rpx rgba(73,52,34,.05);
}
.family-choice:active { background: #f2e8da; color: #914927; }
