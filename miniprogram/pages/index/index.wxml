<!-- 首页：产品调性 + 家风墙 + 访谈主入口 + 家族故事列表 -->
<view class="page-pad safe-bottom home">
  <view class="hero">
    <view class="hero-mark">
      <view class="memory-seal">
        <text>声</text>
        <view class="seal-wave" aria-hidden="true"></view>
      </view>
    </view>
    <text class="title-xl">家声拾记</text>
    <text class="slogan">留住爷爷奶奶的故事</text>
    <text class="desc">AI 记者陪你和家人聊老照片，把口口相传的往事，变成可以传下去的家族故事书。</text>
  </view>

  <view class="stories" wx:if="{{familyLoading}}">
    <view class="section-head family-head">
      <text class="section-title family-title">我的家族</text>
    </view>
    <view class="skel skel-story" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <view class="stories" wx:else>
    <view class="section-head family-head">
      <text class="section-title family-title">我的家族</text>
      <view class="family-actions">
        <button class="family-action" bindtap="openCreate">创建家族</button>
        <button class="family-action" bindtap="openJoin">加入家族</button>
      </view>
    </view>
    <view class="story-item family-item" wx:for="{{families}}" wx:key="_id" hover-class="press-down" bindtap="openFamily" data-id="{{item._id}}">
      <view class="family-item-main">
        <view class="story-item-title">{{item.name}}</view>
        <view class="story-item-meta">查看家族故事 →</view>
      </view>
      <button wx:if="{{item.canDelete}}" class="family-delete" catchtap="deleteFamily"
        data-id="{{item._id}}" data-name="{{item.name}}" aria-label="删除家族">🗑</button>
    </view>
    <view class="family-empty" wx:if="{{!families.length}}">当前还未创建家族~</view>
  </view>

  <view class="entry">
    <button class="btn-primary" bindtap="goToInterview">开始一段家族访谈</button>
    <view class="tip">老人不用打字，开口讲就行</view>
  </view>
</view>

<view class="family-modal" wx:if="{{familyModal}}">
  <view class="family-modal-mask" bindtap="closeFamilyModal"></view>
  <view class="family-modal-box">
    <block wx:if="{{familyModal === 'create'}}">
      <view class="family-modal-title">创建家族</view>
      <input class="family-input" maxlength="40" placeholder="请输入家族名称" value="{{familyName}}" bindinput="onFamilyNameInput" focus />
      <button class="btn-primary" bindtap="createFamily">创建</button>
    </block>
    <block wx:elif="{{familyModal === 'join'}}">
      <view class="family-modal-title">加入家族</view>
      <input class="family-input" maxlength="64" placeholder="请输入家族ID" value="{{familyIdInput}}" bindinput="onFamilyIdInput" focus />
      <button class="btn-primary" bindtap="joinFamily">加入</button>
    </block>
    <block wx:else>
      <view class="family-modal-title">选择访谈所属家族</view>
      <view class="family-choice" wx:for="{{families}}" wx:key="_id" bindtap="chooseInterviewFamily" data-id="{{item._id}}">{{item.name}}</view>
    </block>
    <view class="family-modal-cancel" bindtap="closeFamilyModal">取消</view>
  </view>
</view>

