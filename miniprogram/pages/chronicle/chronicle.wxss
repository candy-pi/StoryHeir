.chronicle { padding-bottom: 60rpx; }

/* 加载骨架：封面 + 章节占位，比"加载中"文字更像马上要出来，老人不会以为卡死 */
.chrono-skel { padding-top: 20rpx; }
.skel-cover { height: 240rpx; border-radius: 28rpx; margin-bottom: 40rpx; }
.skel-line { height: 40rpx; margin-bottom: 24rpx; }
.skel-line.short { width: 50%; }
.skel-card { height: 200rpx; border-radius: 24rpx; margin-bottom: 24rpx; }

/* 卷首封面：内描浅边 + 浅色"志"印记，增强书卷/传承质感 */
.book-cover {
  background-color: #A0522D;
  color: #fff;
  border-radius: 28rpx;
  padding: 56rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.18);
}
.cover-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 46rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.book-title { font-size: 60rpx; font-weight: 700; letter-spacing: 8rpx; }
.book-sub { font-size: 32rpx; margin-top: 24rpx; opacity: 0.92; }
.book-slogan { font-size: 28rpx; margin-top: 28rpx; opacity: 0.85; line-height: 1.6; }
.book-values { font-size: 28rpx; margin-top: 20rpx; opacity: 0.9; }

/* 目录 */
.toc {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 48rpx;
}
.toc-title { font-size: 34rpx; font-weight: 600; color: #2B2218; margin-bottom: 24rpx; }
.toc-line {
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  color: #5b5145;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e8ddcd;
}
.toc-line:last-child { border-bottom: none; }
.toc-count { color: #6e6354; font-size: 28rpx; }

/* 家族时间线：横向滑动，节点圆点对齐横线 */
.timeline-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx 0 36rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}
.timeline-cap { font-size: 32rpx; font-weight: 600; color: #2B2218; padding: 0 40rpx 28rpx; }
.timeline-scroll { width: 100%; }
.timeline-track {
  position: relative;
  display: flex;
  min-width: 100%;
  box-sizing: border-box;
  align-items: flex-start;
  padding: 8rpx 20rpx 0;
}
.tl-node {
  flex-shrink: 0;
  width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.tl-year {
  height: 60rpx;
  line-height: 30rpx;
  font-size: 26rpx;
  color: #A0522D;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}
/* 圆点轴：每节点自带一段贯穿横线，相邻节点的线首尾相接，滚多长线就延伸多长 */
.tl-axis {
  position: relative;
  width: 100%;
  height: 24rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tl-line {
  position: absolute;
  left: 0; right: 0;
  top: 50%;
  height: 2rpx;
  background-color: #a89274;
  transform: translateY(-1rpx);
}
.tl-dot {
  position: relative;
  z-index: 1;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #A0522D;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(160,82,45,0.35);
}
.tl-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #2B2218;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 年代章节 */
.chapter { margin-bottom: 56rpx; }
.chapter-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 28rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #A0522D;
}
.chapter-name { font-size: 42rpx; font-weight: 700; color: #2B2218; }
.chapter-range { font-size: 28rpx; color: #6e6354; margin-left: 20rpx; }

/* 年代色调：不同年代章标题配代表色，翻阅有时间纵深感（name 用深一档保证大字可读 ≥3:1） */
.chapter-head.tone-early { border-left-color: #6b4a2b; }
.chapter-head.tone-early .chapter-name { color: #6b4a2b; }
.chapter-head.tone-mid { border-left-color: #5a6b5a; }
.chapter-head.tone-mid .chapter-name { color: #4a5a4a; }
.chapter-head.tone-warm { border-left-color: #c08a3a; }
.chapter-head.tone-warm .chapter-name { color: #9a6a22; }
.chapter-head.tone-late { border-left-color: #A0522D; }
.chapter-head.tone-late .chapter-name { color: #A0522D; }
.chapter-head.tone-unknown { border-left-color: #8a7a66; }
.chapter-head.tone-unknown .chapter-name { color: #6b5d4d; }

/* 单篇故事卡片：头图 + 标题/年代/预览 */
.chron-story {
  display: flex;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.chron-photo { width: 200rpx; height: 200rpx; flex-shrink: 0; }
.chron-body {
  flex: 1;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.chron-body.no-photo { padding: 36rpx 32rpx; }
.chron-title { font-size: 34rpx; font-weight: 600; color: #2B2218; }
.chron-year { font-size: 26rpx; color: #A0522D; margin: 10rpx 0 14rpx; }
.chron-preview {
  font-size: 28rpx;
  color: #6e6354;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #6e6354;
  font-size: 32rpx;
}

/* 海报按钮区：主（做海报）+ 次（分享卡片）竖排 */
.share-actions { margin-top: 16rpx; }
.share-actions .btn-secondary { margin-top: 24rpx; }

/* 离屏海报画布：移出屏幕不可见，但保留逻辑尺寸供 canvas 2d 绘制并导出图片 */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750rpx;
  height: 1334rpx;
}

/* 编年史：封面与内页使用同一套暖色书卷语言 */
.book-cover {
  background: linear-gradient(150deg, #a75a32 0%, #7e3b27 100%);
  border: 1rpx solid rgba(255,255,255,.16);
  box-shadow: 0 18rpx 42rpx rgba(86,42,27,.2), inset 0 0 0 3rpx rgba(255,255,255,.12);
}
.timeline-card,
.toc,
.chron-story {
  border: 1rpx solid rgba(151,115,82,.12);
  box-shadow: 0 10rpx 28rpx rgba(73,52,34,.07);
}
.chron-story:active { transform: scale(.985); opacity: .92; }
.tl-dot { background: #9a4c2c; }
.chron-year { color: #934a2a; }
